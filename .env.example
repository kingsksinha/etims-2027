# ========================================================
# ETIMS 2027 — Production Environment Variables
# ========================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# PostgreSQL Database (e.g., Supabase, Neon, Railway, Render Postgres)
# If omitted or unavailable, the contact desk safely logs inquiries to stdout.
DATABASE_URL=postgresql://postgres:password@localhost:5432/etims2027?schema=public

# Security & CORS
# In production, set to your custom domain (e.g., https://etims2027.nsiterp.in) or *
CORS_ORIGIN=*
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
